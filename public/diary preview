    *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }

    :root {
      --bg: #F7F6F2;
      --ink: #0D0D0D;
      --muted: rgba(13,13,13,0.4);
      --border: rgba(13,13,13,0.07);
      --card-bg: #ffffff;
      --detail-bg: #FAFAF8;
      --serif: Georgia, 'Times New Roman', serif;
      --sans: -apple-system, 'Helvetica Neue', Arial, sans-serif;
    }

    html { font-family: var(--sans); background: var(--bg); color: var(--ink); }
    body { min-height: 100vh; }
    button { font-family: inherit; cursor: pointer; outline: none; }
    a { text-decoration: none; color: inherit; }

    /* ── header ── */
    .site-header {
      position: sticky; top: 0; z-index: 50;
      display: flex; align-items: center; justify-content: space-between;
      padding: 14px 24px;
      background: rgba(247,246,242,0.92);
      backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border);
    }
    .site-header a, .site-header span {
      font-size: 9px; text-transform: uppercase; letter-spacing: .2em;
      color: var(--muted);
    }
    .site-header .title { color: rgba(13,13,13,0.6); }

    /* ── page container ── */
    .container { max-width: 672px; margin: 0 auto; padding: 32px 16px 80px; }

    /* ── stats panel ── */
    .stats-panel {
      background: var(--card-bg);
      border: 1px solid var(--border);
      padding: 20px;
      margin-bottom: 28px;
    }
    .stats-panel .panel-label {
      font-size: 8px; text-transform: uppercase; letter-spacing: .2em;
      color: rgba(13,13,13,0.35); margin-bottom: 16px;
    }
    .stats-grid {
      display: grid; grid-template-columns: repeat(4,1fr); gap: 16px;
    }
    @media(max-width:520px){ .stats-grid{ grid-template-columns: repeat(2,1fr); } }
    .stat-item .stat-sublabel {
      font-size: 7px; text-transform: uppercase; letter-spacing: .1em;
      color: rgba(13,13,13,0.35); margin-bottom: 4px;
    }
    .stat-item .big-num {
      font-family: var(--serif); font-size: 26px; line-height: 1;
    }
    .stat-item .big-unit { font-size: 8px; color: rgba(13,13,13,0.35); margin-left: 2px; }
    .dot-row { display: flex; align-items: center; gap: 6px; margin-top: 2px; }
    .dot { width: 6px; height: 6px; border-radius: 50%; flex-shrink: 0; }
    .dot-label { font-size: 9px; }
    .dot-count { font-size: 7px; color: rgba(13,13,13,0.35); }

    /* ── filter bar ── */
    .filter-bar { display: flex; align-items: center; gap: 6px; flex-wrap: wrap; margin-bottom: 14px; }
    .filter-label { font-size: 7px; text-transform: uppercase; letter-spacing: .1em; color: rgba(13,13,13,0.35); margin-right: 2px; }
    .filter-btn {
      font-size: 7px; text-transform: uppercase; letter-spacing: .1em;
      padding: 4px 8px;
      border: 1px solid rgba(13,13,13,0.14);
      background: transparent; color: rgba(13,13,13,0.5);
      transition: all .2s;
    }
    .filter-btn.active { background: var(--ink); color: var(--bg); border-color: var(--ink); }
    .filter-btn:hover:not(.active){ background: rgba(13,13,13,0.04); }

    /* ── prescription card ── */
    .rx-card { background: var(--card-bg); border: 1px solid var(--border); margin-bottom: 1px; }
    .rx-head {
      display: flex; align-items: flex-start; gap: 16px;
      padding: 14px 18px;
      width: 100%; text-align: left; background: transparent; border: none;
      cursor: pointer;
    }
    .rx-head:hover { background: rgba(13,13,13,0.015); }

    /* date col */
    .rx-date { flex-shrink: 0; width: 48px; display: flex; flex-direction: column; align-items: center; }
    .rx-index { font-size: 8px; text-transform: uppercase; letter-spacing: .15em; color: rgba(13,13,13,0.28); }
    .rx-day { font-family: var(--serif); font-size: 17px; line-height: 1.1; color: var(--ink); margin-top: 2px; }
    .rx-time { font-size: 8px; color: rgba(13,13,13,0.38); }

    /* mid col */
    .rx-mid { flex: 1; min-width: 0; }
    .rx-meta { display: flex; align-items: center; flex-wrap: wrap; gap: 6px; margin-bottom: 6px; }
    .rx-location { font-size: 10px; }
    .rx-scene {
      font-size: 7px; padding: 2px 6px; border-radius: 20px;
      background: rgba(13,13,13,0.05); color: rgba(13,13,13,0.5);
    }
    .rx-emotions { display: flex; flex-wrap: wrap; gap: 5px; margin-bottom: 7px; }
    .emotion-tag {
      font-size: 8px; padding: 2px 6px;
      background: rgba(13,13,13,0.04); color: var(--ink);
    }
    .rx-excerpt {
      font-size: 10px; line-height: 1.5; color: rgba(13,13,13,0.5);
      font-style: italic;
    }

    /* right col */
    .rx-right { flex-shrink: 0; display: flex; flex-direction: column; align-items: flex-end; gap: 5px; }
    .family-tag {
      font-size: 7px; padding: 2px 6px;
      border: 1px solid; /* set inline */
    }
    .rx-fragname { font-size: 8px; color: rgba(13,13,13,0.55); text-align: right; max-width: 80px; word-break: break-all; }
    .conflict-badge { font-size: 7px; color: #C84B4B; }
    .chevron { font-size: 8px; color: rgba(13,13,13,0.28); transition: transform .2s; margin-top: auto; }
    .chevron.open { transform: rotate(180deg); }

    /* ── detail panel ── */
    .rx-detail {
      border-top: 1px solid rgba(13,13,13,0.06);
      background: var(--detail-bg);
      display: none;
    }
    .rx-detail.open { display: block; }
    .rx-detail-full-date {
      padding: 14px 18px 6px;
      font-size: 8px; text-transform: uppercase; letter-spacing: .14em;
      color: rgba(13,13,13,0.3);
    }

    /* energy rings row */
    .energy-row { display: grid; grid-template-columns: repeat(3,1fr); gap: 10px; padding: 0 18px 14px; }
    .energy-cell {
      display: flex; flex-direction: column; align-items: center;
      padding: 10px 6px 8px;
      border: 1px solid rgba(13,13,13,0.06); background: #fff;
    }
    .energy-cell svg { flex-shrink: 0; }
    .energy-sublabel {
      font-size: 7px; text-transform: uppercase; letter-spacing: .1em;
      color: rgba(13,13,13,0.38); margin-top: 5px;
    }

    /* conflict bar */
    .conflict-bar {
      margin: 0 18px 14px; padding: 8px 12px;
      font-size: 10px; line-height: 1.5;
      background: rgba(200,75,75,0.06);
      border: 1px solid rgba(200,75,75,0.15);
      color: #C84B4B;
    }

    /* tri-mapping */
    .tri-title {
      padding: 0 18px 8px;
      font-size: 8px; text-transform: uppercase; letter-spacing: .14em;
      color: rgba(13,13,13,0.32);
    }
    .tri-grid { display: grid; grid-template-columns: repeat(3,1fr); gap: 8px; padding: 0 18px 14px; }
    .tri-cell { padding: 8px; border: 1px solid rgba(13,13,13,0.06); background: #fff; }
    .tri-cell-icon { font-size: 8px; color: rgba(13,13,13,0.38); margin-bottom: 4px; }
    .tri-cell-label { font-size: 10px; font-weight: 600; color: var(--ink); margin-bottom: 4px; }
    .tri-cell-factors { font-size: 8px; line-height: 1.4; color: rgba(13,13,13,0.44); }

    /* narrative blocks */
    .narrative-block { padding: 0 18px 14px; }
    .block-label {
      font-size: 8px; text-transform: uppercase; letter-spacing: .14em;
      color: rgba(13,13,13,0.32); margin-bottom: 6px;
    }
    .block-text {
      font-size: 11px; line-height: 1.6; color: rgba(13,13,13,0.68);
      font-family: var(--serif); font-style: italic;
    }
    .block-text.small { font-family: var(--sans); font-style: normal; font-size: 10px; color: rgba(13,13,13,0.55); }
    .twin-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 16px; padding: 0 18px 14px; }
    @media(max-width:440px){ .twin-grid{ grid-template-columns:1fr; } }

    /* fragrance list */
    .frag-list { display: flex; flex-direction: column; gap: 6px; padding: 0 18px 14px; }
    .frag-row {
      display: flex; align-items: flex-start; gap: 10px; padding: 8px 10px;
      border: 1px solid rgba(13,13,13,0.06); background: #fff;
    }
    .frag-thumb {
      flex-shrink: 0; width: 32px; height: 42px;
      background: rgba(13,13,13,0.04); overflow: hidden;
    }
    .frag-thumb img { width: 100%; height: 100%; object-fit: cover; }
    .frag-rank { font-size: 7px; color: rgba(13,13,13,0.28); flex-shrink: 0; padding-top: 2px; }
    .frag-info { flex: 1; min-width: 0; }
    .frag-name { font-size: 10px; font-weight: 500; color: var(--ink); }
    .frag-sub { font-size: 8px; color: rgba(13,13,13,0.44); margin-bottom: 3px; }
    .frag-story {
      font-size: 8px; line-height: 1.4;
      color: rgba(13,13,13,0.36);
      font-family: var(--serif); font-style: italic;
    }
    .frag-btn {
      font-size: 7px; text-transform: uppercase; letter-spacing: .1em;
      padding: 4px 8px; flex-shrink: 0;
      border: 1px solid rgba(13,13,13,0.14); color: rgba(13,13,13,0.48);
      background: transparent;
    }
    .frag-btn:hover { background: rgba(13,13,13,0.04); }

    /* CTA row */
    .cta-row { padding: 0 18px 18px; display: flex; align-items: center; gap: 10px; flex-wrap: wrap; }
    .cta-btn {
      display: inline-block; padding: 10px 20px;
      font-size: 8px; text-transform: uppercase; letter-spacing: .15em;
      background: var(--ink); color: var(--bg);
      border: none; cursor: pointer; transition: all .25s;
    }
    .cta-btn:hover { background: var(--bg); color: var(--ink); outline: 1px solid var(--ink); }
    .cta-type { font-size: 7px; color: rgba(13,13,13,0.32); }

