        imageUrl:'/fragrances/luna-rossa-ocean.jpg', purchaseUrl:'/buy/luna-rossa-ocean'
      }
    ],
    healingNarrative: {
      todayStatus: '今晚北京秋高气爽，22℃是最适合社交的温度。你心情很好，像一颗充满电的手机，准备好去发光了。让这瓶柑橘调做你今晚的序曲。',
      scentCombination: '橘皮与橙花的双重柑橘，明亮清爽不抢镜，是会场里最好闻的那个人，又不咄咄逼人。',
      usageGuide: '出门前喷于衬衫领口两侧，保持社交安全距离内若有若无的清新感。',
      meditationGuide: '今晚的你不需要冥想，你已经是一束光了。把好的气场带给你遇见的每一个人。',
      emotionalGuidance: '好的状态是可以传染的。今晚你遇见的人，也会因为你的好心情更快乐一点。',
      commercialCTA: { label:'探索 Infusion de Mandarine', fragranceId:'prada-infusion-mandarine', type:'buy_trial' }
    },
    triMapping: {
      environment: { label:'北京 22℃ ☀️', energy:72, factors:['温度22℃','湿度40%','晴朗天气'] },
      emotion:     { label:'开心·兴奋', energy:80, factors:['开心 😊','兴奋 ⚡'] },
      fragrance:   { label:'Infusion de Mandarine', energy:76, factors:['柑橘调','前调: Mandarine, Bigarade','中调: Orange Blossom'] }
    }
  }
];

// ─────────────────────────────────────────────────────────────
// 工具函数
// ─────────────────────────────────────────────────────────────
function loadPrescriptions() {
  try {
    const raw = localStorage.getItem(STORAGE_KEY);
    if (!raw) return null;
    const parsed = JSON.parse(raw);
    const list = Array.isArray(parsed) ? parsed : [parsed];
    return list.sort((a,b) => new Date(b.createdAt) - new Date(a.createdAt));
  } catch { return null; }
}

function fmtDate(iso) {
  const d = new Date(iso);
  return `${d.getMonth()+1}/${String(d.getDate()).padStart(2,'0')}`;
}
function fmtTime(iso) {
  const d = new Date(iso);
  return `${String(d.getHours()).padStart(2,'0')}:${String(d.getMinutes()).padStart(2,'0')}`;
}
function fmtFull(iso) {
  return new Date(iso).toLocaleDateString('zh-CN',{year:'numeric',month:'long',day:'numeric',weekday:'long'});
}
function truncate(str, n=55) { return str.length>n ? str.slice(0,n)+'…' : str; }

function topFamilies(list) {
  const t={};
  list.forEach(rx => rx.recommendedFragrances.forEach(f => { t[f.family]=(t[f.family]||0)+1; }));
  return Object.entries(t).sort((a,b)=>b[1]-a[1]).slice(0,3).map(([family,count])=>({family,count}));
}
function topEmotions(list) {
  const t={};
  list.forEach(rx => rx.request.user.emotions.forEach(e => { t[e]=(t[e]||0)+1; }));
  return Object.entries(t).sort((a,b)=>b[1]-a[1]).slice(0,3).map(([emotion,count])=>({emotion,count}));
}
function avgScore(list) {
  if(!list.length) return 0;
  return Math.round(list.reduce((s,rx)=>s+rx.energyDeviation.score,0)/list.length);
}
function conflictRate(list) {
  if(!list.length) return 0;
  return Math.round(list.filter(rx=>rx.energyDeviation.hasConflict).length/list.length*100);
}

// ─────────────────────────────────────────────────────────────
// SVG 能量环
// ─────────────────────────────────────────────────────────────
function scoreRingSVG(score) {
  const r = 22, circ = 2*Math.PI*r;
  const filled = (score/100)*circ;
  const color = score>=70 ? '#C84B4B' : score>=40 ? '#E8A44A' : '#8BB87A';
  return `<svg width="56" height="56" viewBox="0 0 56 56" style="transform:rotate(-90deg)">
    <circle cx="28" cy="28" r="${r}" fill="none" stroke="rgba(13,13,13,0.08)" stroke-width="3"/>
    <circle cx="28" cy="28" r="${r}" fill="none" stroke="${color}" stroke-width="3"
      stroke-dasharray="${filled.toFixed(2)} ${(circ-filled).toFixed(2)}" stroke-linecap="round"/>
    <g transform="rotate(90 28 28)">
      <text x="28" y="33" text-anchor="middle" font-size="11" fill="#0D0D0D" font-family="Georgia,serif">${score}</text>
    </g>
  </svg>`;
}

// ─────────────────────────────────────────────────────────────
// HTML 生成
// ─────────────────────────────────────────────────────────────
function renderStatsPanel(list) {
  const avg = avgScore(list);
  const cRate = conflictRate(list);
  const families = topFamilies(list);
  const emotions = topEmotions(list);
  const scoreColor = avg>=60 ? '#C84B4B' : avg>=35 ? '#E8A44A' : '#8BB87A';

  const famRows = families.map(({family,count}) =>
    `<div class="dot-row">
      <span class="dot" style="background:${FAMILY_COLOR[family]}"></span>
      <span class="dot-label">${FAMILY_LABEL[family]||family}</span>
      <span class="dot-count">×${count}</span>
    </div>`).join('');

  const emoRows = emotions.map(({emotion,count}) =>
    `<div class="dot-row">
      <span class="dot-label">${EMOTION_EMOJI[emotion]||''} ${EMOTION_LABEL[emotion]||emotion}</span>
      <span class="dot-count">×${count}</span>
    </div>`).join('');

  return `
  <div class="stats-panel">
    <p class="panel-label">香气人格概览 · ${list.length} 次记录</p>
    <div class="stats-grid">
      <div class="stat-item">
        <p class="stat-sublabel">平均失衡指数</p>
        <div><span class="big-num" style="color:${scoreColor}">${avg}</span><span class="big-unit">/ 100</span></div>
      </div>
      <div class="stat-item">
        <p class="stat-sublabel">冲突日占比</p>
        <div><span class="big-num" style="color:${cRate>=50?'#C84B4B':'#0D0D0D'}">${cRate}%</span></div>
      </div>
      <div class="stat-item">
        <p class="stat-sublabel">偏好香调</p>
        ${famRows}
      </div>
      <div class="stat-item">
        <p class="stat-sublabel">常见情绪</p>
        ${emoRows}
      </div>
    </div>
  </div>`;
}

function renderFilterBar(usedFamilies, active) {
  const allBtn = `<button class="filter-btn${active==='all'?' active':''}" onclick="setFilter('all')">全部</button>`;
  const famBtns = usedFamilies.map(fam => {
    const isActive = active===fam;
    const c = FAMILY_COLOR[fam]||'#888';
    const style = isActive
      ? `border-color:${c};background:${c}18;color:${c}`
      : `border-color:rgba(13,13,13,0.12);color:rgba(13,13,13,0.5)`;
    return `<button class="filter-btn" style="${style}" onclick="setFilter('${fam}')">${FAMILY_LABEL[fam]}</button>`;
  }).join('');
  return `<div class="filter-bar">
    <span class="filter-label">香调筛选</span>
    ${allBtn}${famBtns}
  </div>`;
}

function renderCard(rx, index) {
  const top = rx.recommendedFragrances[0];
  const wEmoji = WEATHER_EMOJI[rx.request.environment.weather]||'🌤';
  const fColor = FAMILY_COLOR[top?.family]||'#888';
  const cardId = `card-${rx.id}`;

  const emotions = rx.request.user.emotions.map(e =>
    `<span class="emotion-tag">${EMOTION_EMOJI[e]||''} ${EMOTION_LABEL[e]||e}</span>`
  ).join('');

  // detail: energy rings
  const rings = [
    {label:'环境能量', val:rx.energyDeviation.environmentEnergy},
    {label:'情绪能量', val:rx.energyDeviation.emotionEnergy},
    {label:'综合偏离', val:rx.energyDeviation.score},
  ].map(({label,val}) =>
    `<div class="energy-cell">${scoreRingSVG(val)}<span class="energy-sublabel">${label}</span></div>`
  ).join('');

  // conflict bar
  const conflictBar = rx.energyDeviation.hasConflict && rx.energyDeviation.conflictDescription
    ? `<div class="conflict-bar">⚡ ${rx.energyDeviation.conflictDescription}</div>`
    : '';

  // tri mapping
  const triItems = [
    {label:'环境', icon: wEmoji, data: rx.triMapping.environment},
    {label:'情绪', icon:'💫', data: rx.triMapping.emotion},
    {label:'香氛', icon:'🌿', data: rx.triMapping.fragrance},
  ].map(({label,icon,data}) =>
    `<div class="tri-cell">
      <div class="tri-cell-icon">${icon} ${label}</div>
      <div class="tri-cell-label">${data.label}</div>
      <div class="tri-cell-factors">${data.factors.slice(0,3).join(' · ')}</div>
    </div>`
  ).join('');

  // fragrance list (with product thumb + story)
  const frags = rx.recommendedFragrances.map((f,i) =>
    `<div class="frag-row">
      ${f.imageUrl ? `<div class="frag-thumb"><img src="${f.imageUrl}" alt="${f.name}" onerror="this.parentElement.style.display='none'"></div>` : ''}
      <span class="frag-rank">0${i+1}</span>
      <div class="frag-info">
        <div class="frag-name">${f.name}</div>
        <div class="frag-sub">${FAMILY_LABEL[f.family]||f.family} · 前调: ${f.notes.top.slice(0,2).join(', ')}</div>
        ${f.story ? `<div class="frag-story">${f.story}</div>` : ''}
      </div>
      <a href="${f.purchaseUrl}" target="_blank" class="frag-btn">探索</a>
    </div>`
  ).join('');

  // find cta fragrance
  const ctaFrag = rx.recommendedFragrances.find(f=>f.id===rx.healingNarrative.commercialCTA.fragranceId)
    || rx.recommendedFragrances[0];

  return `
  <article class="rx-card">
    <button class="rx-head" onclick="toggleCard('${cardId}')" aria-expanded="false" id="btn-${cardId}">
      <div class="rx-date">
        <span class="rx-index">#${String(index+1).padStart(2,'0')}</span>
        <span class="rx-day">${fmtDate(rx.createdAt)}</span>
        <span class="rx-time">${fmtTime(rx.createdAt)}</span>
      </div>
      <div class="rx-mid">
        <div class="rx-meta">
          <span class="rx-location">${wEmoji} ${rx.request.environment.city} ${rx.request.environment.temperature}℃</span>
          <span class="rx-scene">${SCENE_LABEL[rx.request.user.scene]||rx.request.user.scene}</span>
        </div>
        <div class="rx-emotions">${emotions}</div>
        <p class="rx-excerpt">${truncate(rx.healingNarrative.todayStatus)}</p>
      </div>
      <div class="rx-right">
        ${top ? `<span class="family-tag" style="background:${fColor}22;color:${fColor};border-color:${fColor}44">${FAMILY_LABEL[top.family]||top.family}</span>` : ''}
        ${top ? `<span class="rx-fragname">${top.name}</span>` : ''}
        ${rx.energyDeviation.hasConflict ? `<span class="conflict-badge">⚡ 冲突</span>` : ''}
        <span class="chevron" id="chev-${cardId}">▾</span>
      </div>
    </button>

    <div class="rx-detail" id="${cardId}">
      <p class="rx-detail-full-date">${fmtFull(rx.createdAt)}</p>

      <!-- 能量环 -->
      <div class="energy-row">${rings}</div>

      <!-- 冲突描述 -->
      ${conflictBar}

      <!-- 三元映射 -->
      <p class="tri-title">三元映射</p>
      <div class="tri-grid">${triItems}</div>

      <!-- 今日状态 -->
      <div class="narrative-block">
        <p class="block-label">今日状态</p>
        <p class="block-text">${rx.healingNarrative.todayStatus}</p>
      </div>

      <!-- 情绪寄语 -->
      <div class="narrative-block">
        <p class="block-label">情绪寄语</p>
        <p class="block-text">${rx.healingNarrative.emotionalGuidance}</p>
      </div>

      <!-- 推荐香水 -->
      <div class="narrative-block" style="padding-bottom:6px">
        <p class="block-label">推荐香氛</p>
      </div>
      <div class="frag-list">${frags}</div>

      <!-- 使用建议 & 香气组合 -->
      <div class="twin-grid">
        <div>
          <p class="block-label" style="padding:0 0 6px">使用建议</p>
          <p class="block-text small">${rx.healingNarrative.usageGuide}</p>
        </div>
        <div>
          <p class="block-label" style="padding:0 0 6px">香气组合</p>
          <p class="block-text small">${rx.healingNarrative.scentCombination}</p>
        </div>
      </div>

      <!-- 冥想引导 -->
      <div class="narrative-block">
        <p class="block-label">冥想引导</p>
        <p class="block-text">${rx.healingNarrative.meditationGuide}</p>
      </div>

      <!-- CTA -->
      <div class="cta-row">
        <a href="${ctaFrag.purchaseUrl}" target="_blank" class="cta-btn">${rx.healingNarrative.commercialCTA.label}</a>
        <span class="cta-type">${CTA_TYPE_LABEL[rx.healingNarrative.commercialCTA.type]||''}</span>
      </div>
    </div>
  </article>`;
}

function renderEmpty() {
  return `
  <div style="display:flex;flex-direction:column;align-items:center;justify-content:center;padding:80px 0;text-align:center;">
    <div style="width:64px;height:64px;border-radius:50%;border:1px solid rgba(13,13,13,0.08);display:flex;align-items:center;justify-content:center;font-size:26px;margin-bottom:24px;">🌿</div>
    <h2 style="font-family:Georgia,serif;font-size:15px;margin-bottom:10px;color:#0D0D0D;">香气日记尚为空白</h2>
    <p style="font-size:11px;line-height:1.6;color:rgba(13,13,13,0.45);max-width:240px;">
      每次获得专属处方后，<br>它会自动保存在这里，成为你的情绪资产。
    </p>
    <a href="/" style="margin-top:32px;display:inline-block;padding:12px 32px;font-size:9px;text-transform:uppercase;letter-spacing:.15em;background:#0D0D0D;color:#F7F6F2;">
      开始第一次处方
    </a>
  </div>`;
}

// ─────────────────────────────────────────────────────────────
// 状态 & 渲染
// ─────────────────────────────────────────────────────────────
let allPrescriptions = [];
let currentFilter = 'all';

function render() {
  const app = document.getElementById('app');
  const countEl = document.getElementById('total-count');
  countEl.textContent = `${allPrescriptions.length} 条记录`;

  if (!allPrescriptions.length) {
    app.innerHTML = renderEmpty();
    return;
  }

  const filtered = currentFilter === 'all'
    ? allPrescriptions
    : allPrescriptions.filter(rx => rx.recommendedFragrances.some(f => f.family===currentFilter));

  const usedFamilies = [...new Set(allPrescriptions.flatMap(rx => rx.recommendedFragrances.map(f=>f.family)))];

  let html = renderStatsPanel(allPrescriptions);
  if (usedFamilies.length > 1) {
    html += renderFilterBar(usedFamilies, currentFilter);
  }
  if (currentFilter !== 'all') {
    html += `<p class="filter-count">显示 ${filtered.length} / ${allPrescriptions.length} 条记录</p>`;
  }
  html += filtered.map((rx,i) => renderCard(rx,i)).join('');
  html += `<div class="bottom-cta"><a href="/">+ 新建今日处方</a></div>`;

  app.innerHTML = html;
}

window.setFilter = function(fam) {
  currentFilter = fam;
  render();
};

window.toggleCard = function(cardId) {
  const detail = document.getElementById(cardId);
  const chev = document.getElementById('chev-'+cardId);
  const btn = document.getElementById('btn-'+cardId);
  const isOpen = detail.classList.contains('open');
  detail.classList.toggle('open', !isOpen);
  chev.classList.toggle('open', !isOpen);
  btn.setAttribute('aria-expanded', String(!isOpen));
};

// ─────────────────────────────────────────────────────────────
// 初始化：优先读真实 localStorage，fallback 到 Mock 数据
// ─────────────────────────────────────────────────────────────
document.addEventListener('DOMContentLoaded', () => {
  const real = loadPrescriptions();
  allPrescriptions = real && real.length ? real : MOCK_PRESCRIPTIONS;
  render();
});
</script>
