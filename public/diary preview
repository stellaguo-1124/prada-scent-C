      padding: 0 18px 14px;
    }

    /* ── bottom new-entry cta ── */
    .bottom-cta { text-align: center; margin-top: 36px; }
    .bottom-cta a {
      display: inline-block; padding: 12px 32px;
      font-size: 9px; text-transform: uppercase; letter-spacing: .15em;
      border: 1px solid rgba(13,13,13,0.18); color: rgba(13,13,13,0.55);
      transition: all .25s;
    }
    .bottom-cta a:hover { background: rgba(13,13,13,0.04); }

    /* record count hint */
    .filter-count { font-size: 8px; color: rgba(13,13,13,0.32); margin-bottom: 10px; }
  </style>
</head>
